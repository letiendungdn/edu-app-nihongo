<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>aps-environment</key>
    <string>development</string>
    <!-- Dùng chung dữ liệu với widget (UserDefaults suite) -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.edu.nihongo.ios</string>
    </array>
    <!-- Apple Pay: merchant ID phải được tạo trên Apple Developer và gắn chứng chỉ của Stripe -->
    <key>com.apple.developer.in-app-payments</key>
    <array>
        <string>merchant.com.edu.nihongo</string>
    </array>
</dict>
</plist>
