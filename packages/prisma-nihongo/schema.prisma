generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  USER
  TEACHER
  ADMIN
}

enum JlptLevel {
  N5
  N4
  N3
  N2
  N1
}

enum ExerciseType {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  LISTENING
}

enum ContentType {
  VOCABULARY
  GRAMMAR
  KANJI
}

enum KanaScript {
  HIRAGANA
  KATAKANA
}

enum JlptSessionStatus {
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  UPCOMING
  PAST
}

// ─────────────────────────────────────────────
// Content
// ─────────────────────────────────────────────

/// Giáo trình mà bài học thuộc về. null = nội dung JLPT chung của app.
/// SOUMATOME / SHINKANZEN / TRY là bài soạn riêng theo khung sách → không tính vào kho theo cấp (tránh trùng).
enum Textbook {
  MINNA
  KLL
  SOUMATOME
  SHINKANZEN
  TRY
}

/// Danh mục bộ giáo trình tham khảo (menu "Giáo trình", trang /textbooks, khung sách ở mind map).
model TextbookSeries {
  id         Int            @id @default(autoincrement())
  code       Textbook       @unique
  name       String
  nameJa     String
  publisher  String
  url        String
  blurb      String         @db.Text
  /// Ký tự hiển thị ở menu
  icon       String
  /// Các cấp có lộ trình học trong app
  planLevels JlptLevel[]
  /// Regex nhận diện mục của bộ sách trong "File nghe sách" (không phân biệt hoa thường)
  audioMatch String?
  sortOrder  Int            @default(0)
  books      TextbookBook[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

/// Một cuốn sách của bộ giáo trình theo cấp + kỹ năng.
model TextbookBook {
  id        Int            @id @default(autoincrement())
  seriesId  Int
  series    TextbookSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  level     JlptLevel
  title     String
  note      String?
  /// Không có link khi không có nơi bán chính thức (vd bản cộng đồng)
  url       String?
  kinds     MindMapKind[]
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([seriesId, level, sortOrder])
}

model Lesson {
  id           Int          @id @default(autoincrement())
  lessonNumber Int          @unique
  title        String?
  description  String?
  jlptLevel    JlptLevel?
  textbook     Textbook?
  thumbnailUrl String?
  sortOrder    Int          @default(0)
  vocabularies Vocabulary[]
  grammars     Grammar[]
  exercises    Exercise[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([jlptLevel, sortOrder])
  @@index([textbook, lessonNumber])
}

model Vocabulary {
  id            Int                   @id @default(autoincrement())
  kanji         String?
  kana          String
  romaji        String
  meaning       String
  meaningEn     String?
  partOfSpeech  String?
  jlptLevel     JlptLevel?
  pitchAccent   String?
  audioUrl      String?
  imageUrl      String?
  exampleJa     String?
  exampleKana   String?
  exampleVi     String?
  frequencyRank Int?
  sortOrder     Int                   @default(0)
  lessonId      Int
  lesson        Lesson                @relation(fields: [lessonId], references: [id])
  dictations    DictationAttempt[]
  kanjiVocabs   KanjiVocab[]
  kanjiLinks    VocabularyKanjiLink[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([lessonId, sortOrder])
  @@index([jlptLevel])
}

model Grammar {
  id             Int        @id @default(autoincrement())
  pattern        String
  meaning        String
  explanation    String?
  jlptLevel      JlptLevel?
  formalityLevel String?
  sortOrder      Int        @default(0)
  lessonId       Int
  lesson         Lesson     @relation(fields: [lessonId], references: [id])
  examples       Example[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([lessonId, sortOrder])
  @@index([jlptLevel])
}

model Example {
  id        Int     @id @default(autoincrement())
  jp        String
  romaji    String
  en        String?
  vi        String?
  audioUrl  String?
  sortOrder Int     @default(0)
  grammarId Int
  grammar   Grammar @relation(fields: [grammarId], references: [id], onDelete: Cascade)
}

model Exercise {
  id          Int              @id @default(autoincrement())
  type        ExerciseType
  question    String
  answer      String
  explanation String?
  audioUrl    String?
  difficulty  Int              @default(1)
  sortOrder   Int              @default(0)
  lessonId    Int
  lesson      Lesson           @relation(fields: [lessonId], references: [id])
  options     ExerciseOption[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([lessonId, sortOrder])
}

model ExerciseOption {
  id         Int      @id @default(autoincrement())
  exerciseId Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  sortOrder  Int      @default(0)

  @@index([exerciseId, sortOrder])
}

// ─────────────────────────────────────────────
// Kana charts
// ─────────────────────────────────────────────

model KanaSection {
  id        Int        @id @default(autoincrement())
  script    KanaScript
  slug      String
  title     String
  subtitle  String?
  columns   Int        @default(5)
  sortOrder Int        @default(0)
  cells     KanaCell[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([script, slug])
  @@index([script, sortOrder])
}

model KanaCell {
  id        Int         @id @default(autoincrement())
  sectionId Int
  section   KanaSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  rowIndex  Int
  colIndex  Int
  kana      String      @default("")
  romaji    String      @default("")

  @@unique([sectionId, rowIndex, colIndex])
}

/// Tra cứu kana → romaji (dùng cho dịch nhanh, TTS overlay)
model KanaRomaji {
  id        Int      @id @default(autoincrement())
  kana      String   @unique
  romaji    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Japanese counters
// ─────────────────────────────────────────────

model CounterCategory {
  id        Int           @id @default(autoincrement())
  slug      String        @unique
  label     String
  hint      String
  sortOrder Int           @default(0)
  items     CounterItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model CounterItem {
  id            Int             @id @default(autoincrement())
  categoryId    Int
  category      CounterCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  displayNumber String
  kanji         String?
  kana          String
  romaji        String
  meaningVi     String
  sortOrder     Int             @default(0)

  @@index([categoryId, sortOrder])
}

// ─────────────────────────────────────────────
// Japanese country names (reference)
// ─────────────────────────────────────────────

model CountryRegion {
  id        Int               @id @default(autoincrement())
  slug      String            @unique
  label     String
  sortOrder Int               @default(0)
  items     CountryNameItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([sortOrder])
}

model CountryNameItem {
  id          Int           @id @default(autoincrement())
  regionId    Int
  region      CountryRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  nameJa      String
  kana        String
  romaji      String
  meaningVi   String
  /// ISO 3166-1 alpha-2 (hoặc mã đặc biệt như UN/EU cho vùng)
  countryCode String
  sortOrder   Int           @default(0)

  @@index([regionId, sortOrder])
}

// ─────────────────────────────────────────────
// Japanese vocab suffixes 接尾語 (reference)
// ─────────────────────────────────────────────

model VocabSuffixGroup {
  id        Int               @id @default(autoincrement())
  slug      String            @unique
  label     String
  labelJa   String            @default("")
  hint      String
  sortOrder Int               @default(0)
  items     VocabSuffixItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([sortOrder])
}

model VocabSuffixItem {
  id         Int              @id @default(autoincrement())
  groupId    Int
  group      VocabSuffixGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  suffix     String
  forms      String[]         @default([])
  kana       String
  romaji     String
  meaningVi  String
  attachesTo String
  pos        String[]         @default([])
  exampleJa  String
  exampleVi  String
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([groupId, sortOrder])
}

// ─────────────────────────────────────────────
// Home page stats & feature sections
// ─────────────────────────────────────────────

model HomeStat {
  id        Int      @id @default(autoincrement())
  value     String
  label     String
  suffix    String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model HomeFeatureSection {
  id        Int               @id @default(autoincrement())
  slug      String            @unique
  title     String
  sortOrder Int               @default(0)
  items     HomeFeatureItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([sortOrder])
}

model HomeFeatureItem {
  id        Int                @id @default(autoincrement())
  sectionId Int
  section   HomeFeatureSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  href      String
  icon      String
  title     String
  desc      String
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([sectionId, sortOrder])
}

// ─────────────────────────────────────────────
// Conversation / 自己紹介 & daily phrases
// ─────────────────────────────────────────────

model ConversationIntroLine {
  id        Int      @id @default(autoincrement())
  ja        String
  kana      String
  romaji    String
  vi        String
  tip       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model ConversationIntroSlot {
  id        Int                        @id @default(autoincrement())
  slot      String
  question  String
  sortOrder Int                        @default(0)
  examples  ConversationIntroExample[]
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  @@index([sortOrder])
}

model ConversationIntroExample {
  id        Int                   @id @default(autoincrement())
  slotId    Int
  slot      ConversationIntroSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  ja        String
  kana      String
  romaji    String
  vi        String
  note      String?
  sortOrder Int                   @default(0)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([slotId, sortOrder])
}

model ConversationPhraseGroup {
  id        Int                      @id @default(autoincrement())
  slug      String                   @unique
  label     String
  hint      String
  sortOrder Int                      @default(0)
  items     ConversationPhraseItem[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([sortOrder])
}

model ConversationPhraseItem {
  id        Int                     @id @default(autoincrement())
  groupId   Int
  group     ConversationPhraseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ja        String
  kana      String
  romaji    String
  vi        String
  note      String?
  sortOrder Int                     @default(0)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([groupId, sortOrder])
}

// ─────────────────────────────────────────────
// Roleplay / đóng vai hội thoại
// ─────────────────────────────────────────────

model RoleplayScene {
  id        Int            @id @default(autoincrement())
  slug      String         @unique
  title     String
  titleJa   String
  desc      String
  sortOrder Int            @default(0)
  lines     RoleplayLine[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([sortOrder])
}

model RoleplayLine {
  id        Int           @id @default(autoincrement())
  sceneId   Int
  scene     RoleplayScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  role      String
  ja        String
  vi        String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([sceneId, sortOrder])
}

// ─────────────────────────────────────────────
// Japanese pronunciation rules (reference)
// ─────────────────────────────────────────────

model PronunciationRulesMeta {
  id        Int      @id @default(1)
  intro     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PronunciationRuleTip {
  id        Int      @id @default(autoincrement())
  text      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model PronunciationRuleSection {
  id        Int                        @id @default(autoincrement())
  slug      String                     @unique
  title     String
  summary   String
  sortOrder Int                        @default(0)
  points    PronunciationRulePoint[]
  examples  PronunciationRuleExample[]
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  @@index([sortOrder])
}

model PronunciationRulePoint {
  id          Int                      @id @default(autoincrement())
  sectionId   Int
  section     PronunciationRuleSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label       String?
  japanese    String?
  romaji      String?
  explanation String
  sortOrder   Int                      @default(0)

  @@index([sectionId, sortOrder])
}

model PronunciationRuleExample {
  id        Int                      @id @default(autoincrement())
  sectionId Int
  section   PronunciationRuleSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  japanese  String
  romaji    String
  meaning   String
  note      String?
  sortOrder Int                      @default(0)

  @@index([sectionId, sortOrder])
}

// ─────────────────────────────────────────────
// English ↔ Katakana (reference)
// ─────────────────────────────────────────────

model EnglishKatakanaMeta {
  id        Int      @id @default(1)
  intro     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EnglishKatakanaTip {
  id        Int      @id @default(autoincrement())
  text      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model EnglishKatakanaSection {
  id        Int                      @id @default(autoincrement())
  slug      String                   @unique
  title     String
  summary   String
  sortOrder Int                      @default(0)
  points    EnglishKatakanaPoint[]
  mappings  EnglishKatakanaMapping[]
  examples  EnglishKatakanaExample[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([sortOrder])
}

model EnglishKatakanaPoint {
  id          Int                    @id @default(autoincrement())
  sectionId   Int
  section     EnglishKatakanaSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  explanation String
  english     String?
  katakana    String?
  romaji      String?
  sortOrder   Int                    @default(0)

  @@index([sectionId, sortOrder])
}

model EnglishKatakanaMapping {
  id        Int                    @id @default(autoincrement())
  sectionId Int
  section   EnglishKatakanaSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  english   String
  katakana  String
  romaji    String
  note      String?
  sortOrder Int                    @default(0)

  @@index([sectionId, sortOrder])
}

model EnglishKatakanaExample {
  id        Int                    @id @default(autoincrement())
  sectionId Int
  section   EnglishKatakanaSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  english   String
  katakana  String
  romaji    String
  meaningVi String
  note      String?
  sortOrder Int                    @default(0)

  @@index([sectionId, sortOrder])
}

// ─────────────────────────────────────────────
// Daily listening
// ─────────────────────────────────────────────

model ListeningConfig {
  id          Int @id @default(1)
  goalMinutes Int @default(15)
}

model PodcastResource {
  id          Int      @id @default(autoincrement())
  externalKey String   @unique
  title       String
  description String
  url         String
  level       String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ListeningPreset {
  id          Int      @id @default(autoincrement())
  externalKey String   @unique
  label       String
  lessonFrom  Int
  lessonTo    Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// File nghe / link sách (Mailee Books & tương tự)
model BookAudioMeta {
  id        Int      @id @default(1)
  sourceUrl String
  publisher String
  updatedAt DateTime @updatedAt
}

model BookAudioItem {
  id          Int                   @id @default(autoincrement())
  externalKey String                @unique
  level       String
  title       String
  url         String
  note        String?
  listNo      Int?
  sortOrder   Int                   @default(0)
  driveId     String?
  driveKind   String?
  folderId    Int?
  folder      BookAudioDriveFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  files       BookAudioFile[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([level, sortOrder])
  @@index([folderId])
  @@index([driveId])
}

model BookAudioDriveFolder {
  id           Int             @id @default(autoincrement())
  driveId      String          @unique
  title        String?
  localPath    String?
  fileCount    Int             @default(0)
  downloadedAt DateTime?
  items        BookAudioItem[]
  files        BookAudioFile[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model BookAudioFile {
  id          Int                   @id @default(autoincrement())
  folderId    Int?
  folder      BookAudioDriveFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  itemId      Int?
  item        BookAudioItem?        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  driveFileId String?
  fileName    String
  localPath   String
  mimeType    String?
  sizeBytes   Int?
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([folderId, sortOrder])
  @@index([itemId, sortOrder])
}

// ─────────────────────────────────────────────
// JLPT Đà Nẵng (static fallback)
// ─────────────────────────────────────────────

model JlptOrganizer {
  id               Int      @id @default(1)
  name             String
  shortName        String
  address          String
  phone            String
  email            String
  website          String
  announcementsUrl String
  updatedAt        DateTime @updatedAt
}

model JlptExamFeeInfo {
  id      Int    @id @default(1)
  formFee String
  examFee String
  note    String
}

model JlptExamBriefing {
  id   Int    @id @default(1)
  text String
}

model JlptExamSession {
  id                 Int               @id @default(autoincrement())
  externalKey        String            @unique
  label              String
  examDate           String
  registrationPeriod String
  status             JlptSessionStatus
  statusLabel        String
  announcementUrl    String?
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model JlptExamVenue {
  id        Int      @id @default(autoincrement())
  address   String
  district  String
  levels    String
  note      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JlptExamDaySlot {
  id        Int      @id @default(autoincrement())
  levels    String
  arriveAt  String
  startAt   String
  venue     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// JLPT roadmap
// ─────────────────────────────────────────────

model JlptRoadmapMeta {
  id               Int    @id @default(1)
  examScheduleNote String
}

model StudyTip {
  id        Int      @id @default(autoincrement())
  text      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JlptRoadmapLevel {
  id               Int                      @id @default(autoincrement())
  externalKey      String                   @unique
  label            String
  badge            String
  color            String
  duration         String
  vocabTarget      String
  kanjiTarget      String
  grammarTarget    String                   @default("")
  vocabIncrement   String                   @default("")
  kanjiIncrement   String                   @default("")
  grammarIncrement String                   @default("")
  passScore        String
  summary          String
  sortOrder        Int                      @default(0)
  examSections     JlptRoadmapExamSection[]
  materials        JlptRoadmapMaterial[]
  phases           JlptRoadmapPhase[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

model JlptRoadmapExamSection {
  id        Int              @id @default(autoincrement())
  levelId   Int
  level     JlptRoadmapLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  name      String
  points    Int
  time      String
  sortOrder Int              @default(0)

  @@index([levelId, sortOrder])
}

model JlptRoadmapMaterial {
  id            Int              @id @default(autoincrement())
  levelId       Int
  level         JlptRoadmapLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  title         String
  description   String
  scope         String
  inAppPath     String?
  inAppLabel    String?
  externalUrl   String?
  externalLabel String?
  sortOrder     Int              @default(0)

  @@index([levelId, sortOrder])
}

model JlptRoadmapPhase {
  id          Int               @id @default(autoincrement())
  levelId     Int
  level       JlptRoadmapLevel  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  externalKey String
  title       String
  subtitle    String
  sortOrder   Int               @default(0)
  tasks       JlptRoadmapTask[]

  @@unique([levelId, externalKey])
  @@index([levelId, sortOrder])
}

model JlptRoadmapTask {
  id            Int              @id @default(autoincrement())
  phaseId       Int
  phase         JlptRoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  externalKey   String
  text          String
  inAppPath     String?
  inAppLabel    String?
  externalUrl   String?
  externalLabel String?
  sortOrder     Int              @default(0)

  @@unique([phaseId, externalKey])
  @@index([phaseId, sortOrder])
}

// ─────────────────────────────────────────────
// Kanji
// ─────────────────────────────────────────────

model KanjiLesson {
  id           Int          @id @default(autoincrement())
  lessonNumber Int          @unique
  title        String?
  jlptLevel    JlptLevel?
  textbook     Textbook?
  sortOrder    Int          @default(0)
  entries      KanjiEntry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([jlptLevel, sortOrder])
  @@index([textbook, lessonNumber])
}

model KanjiEntry {
  id           Int                   @id @default(autoincrement())
  character    String
  hanViet      String?
  onyomi       String?
  kunyomi      String?
  meaningVi    String
  meaningEn    String?
  mnemonicJp   String?
  mnemonicVi   String?
  imageUrl     String?
  jlptLevel    JlptLevel?
  strokeCount  Int?
  frequency    Int?
  grade        Int?
  sortOrder    Int                   @default(0)
  lessonId     Int
  lesson       KanjiLesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  vocabularies KanjiVocab[]
  vocabLinks   VocabularyKanjiLink[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([lessonId, sortOrder])
  @@index([character])
  @@index([jlptLevel])
}

model KanjiVocab {
  id           Int         @id @default(autoincrement())
  word         String
  reading      String
  meaningVi    String
  exampleJa    String?
  exampleKana  String?
  exampleVi    String?
  sortOrder    Int         @default(0)
  kanjiEntryId Int
  kanjiEntry   KanjiEntry  @relation(fields: [kanjiEntryId], references: [id], onDelete: Cascade)
  /// Từ vựng Minna/JLPT tương ứng (nếu khớp) — dữ liệu có sẵn trong DB, trước đây nằm ngoài schema.
  vocabularyId Int?
  vocabulary   Vocabulary? @relation(fields: [vocabularyId], references: [id], onDelete: SetNull)

  @@index([kanjiEntryId, sortOrder])
  @@index([vocabularyId])
}

/// Liên kết từ vựng ↔ kanji (từ chứa chữ kanji nào). Bảng có sẵn trong DB (~2.5k dòng),
/// trước đây tạo bằng db push nên nằm ngoài schema — giữ lại, không xóa.
model VocabularyKanjiLink {
  id           Int        @id @default(autoincrement())
  vocabularyId Int
  kanjiEntryId Int
  createdAt    DateTime   @default(now())
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  kanjiEntry   KanjiEntry @relation(fields: [kanjiEntryId], references: [id], onDelete: Cascade)

  @@unique([vocabularyId, kanjiEntryId])
  @@index([kanjiEntryId])
}

// ─────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────

model User {
  id               Int        @id @default(autoincrement())
  email            String     @unique
  passwordHash     String?
  googleId         String?    @unique
  keycloakId       String?    @unique
  role             Role       @default(USER)
  name             String?
  avatarUrl        String?
  nativeLanguage   String?    @default("vi")
  targetJlptLevel  JlptLevel?
  studyGoalMinutes Int?       @default(30)
  lastActiveAt     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  emailVerifiedAt DateTime?
  emailBounced    Boolean   @default(false)

  srsCards                SrsCard[]
  pushTokens              PushDeviceToken[]
  emailVerificationTokens EmailVerificationToken[]
  emailPrefs              EmailPrefs?
  examResults             ExamResult[]
  listeningLogs           ListeningLog[]
  studySessions           StudySession[]
  studyStreak             StudyStreak?
  dailyNotes              DailyNote[]
  dailyGoals              DailyGoal[]
  dailyActivities         DailyActivity[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  subscription            Subscription?
  coachProfile            CoachProfile?
  learnerSessions         CoachingSession[]        @relation("LearnerSessions")
  payments                Payment[]
  reviewsGiven            CoachReview[]
  sentMessages            ChatMessage[]            @relation("SentMessages")
  notifications           Notification[]
  supportThread           SupportThread?
  supportMessages         SupportMessage[]         @relation("SupportMessages")
  createdLearnerChats     LearnerChatRoom[]        @relation("CreatedLearnerChats")
  learnerChatMembers      LearnerChatMember[]
  learnerChatMessages     LearnerChatMessage[]     @relation("LearnerChatMessages")
  liveSessions            LiveSession[]

  @@index([role])
}

model LiveSession {
  id        Int       @id @default(autoincrement())
  roomName  String    @unique
  coachId   Int
  coach     User      @relation(fields: [coachId], references: [id])
  title     String
  status    String    @default("LIVE")
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([status])
  @@index([coachId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// SRS — Spaced Repetition (SM-2)
// ─────────────────────────────────────────────

// Không còn snapshot fields (kana, kanji, meaning, lessonNumber).
// Dùng contentType + contentId để join sang đúng bảng khi cần hiển thị.
model SrsCard {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType ContentType
  contentId   Int

  // SM-2 algorithm fields
  easeFactor     Float     @default(2.5)
  interval       Int       @default(0)
  repetitions    Int       @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?

  // Statistics
  correctCount Int     @default(0)
  wrongCount   Int     @default(0)
  reviewStreak Int     @default(0)
  mastered     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, contentType, contentId])
  @@index([userId, nextReviewAt])
  @@index([userId, contentType, mastered])
}

// ─────────────────────────────────────────────
// Progress & Exam
// ─────────────────────────────────────────────

model ExamResult {
  id           Int                 @id @default(autoincrement())
  userId       Int?
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  examId       String
  level        String
  title        String
  correctCount Int
  total        Int
  percent      Float
  passed       Boolean
  submittedAt  DateTime            @default(now())
  sections     ExamSectionResult[]

  @@index([userId, submittedAt])
  @@index([level])
}

model ExamSectionResult {
  id           Int        @id @default(autoincrement())
  examResultId Int
  examResult   ExamResult @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  section      String
  correct      Int
  total        Int
  percent      Float

  @@index([examResultId])
}

/// Cấu hình đề thi thử JLPT — admin quản lý qua /mock-exam.
model MockExamTemplate {
  id                     Int                @id @default(autoincrement())
  slug                   String             @unique
  level                  String
  title                  String
  description            String             @default("")
  /// GENERATED = rút ngẫu nhiên từ bài học; CUSTOM = câu hỏi tự soạn
  sourceMode             String             @default("GENERATED")
  durationMinutes        Int
  lessonFrom             Int                @default(1)
  lessonTo               Int                @default(1)
  kanjiLessonFrom        Int                @default(1)
  kanjiLessonTo          Int                @default(1)
  vocabCount             Int                @default(12)
  grammarCount           Int                @default(10)
  kanjiCount             Int                @default(5)
  listeningWordCount     Int                @default(4)
  listeningSentenceCount Int                @default(4)
  passThreshold          Int                @default(65)
  scope                  String             @default("")
  isPublished            Boolean            @default(true)
  sortOrder              Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  questions              MockExamQuestion[]

  @@index([level, sortOrder])
  @@index([isPublished, sortOrder])
}

model MockExamQuestion {
  id            Int                      @id @default(autoincrement())
  templateId    Int
  template      MockExamTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// vocab | grammar | kanji | listening
  sectionId     String
  /// multiple_choice | fill_in_blank | listening
  type          String
  question      String
  correctAnswer String
  imageUrl      String?
  audioText     String?
  audioUrl      String?
  sortOrder     Int                      @default(0)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  options       MockExamQuestionOption[]

  @@index([templateId, sortOrder])
}

model MockExamQuestionOption {
  id         Int              @id @default(autoincrement())
  questionId Int
  question   MockExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  imageUrl   String?
  sortOrder  Int              @default(0)

  @@index([questionId, sortOrder])
}

model ListeningLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  seconds    Int      @default(0)
  lessonFrom Int?
  lessonTo   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
}

model StudySession {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  seconds       Int      @default(0)
  cardsReviewed Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([userId, date])
}

// Read model (view learner_daily_study + materialized view learner_progress_summary)
// do Flyway quản lý: infra/flyway/sql/V1__learner_progress_views.sql

// Streak tách riêng để tránh recompute từ StudySession mỗi lần hiển thị
model StudyStreak {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastStudyDate String? // YYYY-MM-DD
  updatedAt     DateTime @updatedAt
}

// Daily activity tracking (vocab studied, kanji practiced, etc.)
model DailyActivity {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  kind      String // 'vocab' | 'kanji'
  count     Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([userId, date, kind])
}

// ─────────────────────────────────────────────
// Reading
// ─────────────────────────────────────────────

model ReadingPassage {
  id           Int               @id @default(autoincrement())
  title        String
  content      String            @db.Text
  jlptLevel    JlptLevel?
  source       String?
  estimatedMin Int               @default(3)
  sortOrder    Int               @default(0)
  questions    ReadingQuestion[]
  attempts     ReadingAttempt[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([jlptLevel, sortOrder])
}

model ReadingQuestion {
  id          Int                     @id @default(autoincrement())
  passageId   Int
  passage     ReadingPassage          @relation(fields: [passageId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  explanation String?
  sortOrder   Int                     @default(0)
  options     ReadingQuestionOption[]

  @@index([passageId, sortOrder])
}

model ReadingQuestionOption {
  id         Int             @id @default(autoincrement())
  questionId Int
  question   ReadingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  sortOrder  Int             @default(0)

  @@index([questionId, sortOrder])
}

model ReadingAttempt {
  id          Int            @id @default(autoincrement())
  userId      Int?
  passageId   Int
  passage     ReadingPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  correct     Int
  total       Int
  percent     Float
  submittedAt DateTime       @default(now())

  @@index([userId, submittedAt])
  @@index([passageId])
}

// ─────────────────────────────────────────────
// Dictation
// ─────────────────────────────────────────────

model DictationAttempt {
  id        Int        @id @default(autoincrement())
  userId    Int?
  vocabId   Int
  vocab     Vocabulary @relation(fields: [vocabId], references: [id], onDelete: Cascade)
  userInput String
  correct   Boolean
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([vocabId])
}

// ─────────────────────────────────────────────
// Daily notes & goals
// ─────────────────────────────────────────────

model DailyNote {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// Thay items Json bằng bảng riêng để query và update từng item
model DailyGoal {
  id        Int             @id @default(autoincrement())
  userId    Int
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     DailyGoalItem[]

  @@unique([userId, date])
}

model DailyGoalItem {
  id        Int       @id @default(autoincrement())
  goalId    Int
  goal      DailyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean   @default(false)
  sortOrder Int       @default(0)

  @@index([goalId, sortOrder])
}

// ─────────────────────────────────────────────
// Payment & Marketplace Enums
// ─────────────────────────────────────────────

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  PAUSED
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  PRO_ANNUAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SessionStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_SHOW
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

// ─────────────────────────────────────────────
// Subscription (Learner trả tiền platform)
// ─────────────────────────────────────────────

model SubscriptionPlanConfig {
  id             Int              @id @default(autoincrement())
  plan           SubscriptionPlan @unique
  displayName    String
  priceUsdCents  Int
  intervalMonths Int              @default(1)
  trialDays      Int              @default(0)
  features       Json
  stripePriceId  String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Subscription {
  id                   Int                @id @default(autoincrement())
  userId               Int                @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  canceledAt           DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  payments             Payment[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([stripeCustomerId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Coach Profile (TEACHER user mở rộng)
// ─────────────────────────────────────────────

model CoachProfile {
  id              Int                 @id @default(autoincrement())
  userId          Int                 @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String?             @db.Text
  languages       String[]
  specializations String[]
  hourlyRateUsd   Int
  currency        String              @default("USD")
  timezone        String              @default("Asia/Ho_Chi_Minh")
  isActive        Boolean             @default(false)
  isVerified      Boolean             @default(false)
  featuredUntil   DateTime?
  totalSessions   Int                 @default(0)
  avgRating       Float?
  reviewCount     Int                 @default(0)
  stripeAccountId String?             @unique
  payoutEnabled   Boolean             @default(false)
  availability    CoachAvailability[]
  sessions        CoachingSession[]
  reviews         CoachReview[]
  payouts         Payout[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([isActive, avgRating])
  @@index([isActive, hourlyRateUsd])
}

model CoachAvailability {
  id          Int          @id @default(autoincrement())
  coachId     Int
  coach       CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startHour   Int
  startMinute Int          @default(0)
  endHour     Int
  endMinute   Int          @default(0)

  @@index([coachId, dayOfWeek])
}

// ─────────────────────────────────────────────
// Coaching Session (Booking)
// ─────────────────────────────────────────────

model CoachingSession {
  id                 Int           @id @default(autoincrement())
  learnerId          Int
  learner            User          @relation("LearnerSessions", fields: [learnerId], references: [id])
  coachId            Int
  coach              CoachProfile  @relation(fields: [coachId], references: [id])
  status             SessionStatus @default(PENDING)
  scheduledAt        DateTime
  durationMin        Int           @default(60)
  topic              String?
  notes              String?       @db.Text
  priceUsdCents      Int
  platformFeePercent Int           @default(20)
  payment            Payment?
  review             CoachReview?
  canceledAt         DateTime?
  canceledBy         String?
  cancelReason       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  messages           ChatMessage[]

  @@index([learnerId, scheduledAt])
  @@index([coachId, scheduledAt])
  @@index([status, scheduledAt])
}

// ─────────────────────────────────────────────
// Payment
// ─────────────────────────────────────────────

model Payment {
  id                    Int              @id @default(autoincrement())
  userId                Int
  user                  User             @relation(fields: [userId], references: [id])
  amountCents           Int
  currency              String           @default("USD")
  status                PaymentStatus    @default(PENDING)
  stripePaymentIntentId String?          @unique
  stripeChargeId        String?
  stripeReceiptUrl      String?
  subscriptionId        Int?
  subscription          Subscription?    @relation(fields: [subscriptionId], references: [id])
  sessionId             Int?             @unique
  session               CoachingSession? @relation(fields: [sessionId], references: [id])
  refundedAt            DateTime?
  refundAmountCents     Int?
  refundReason          String?
  metadata              Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

// ─────────────────────────────────────────────
// Payout (platform → Coach qua Stripe Connect)
// ─────────────────────────────────────────────

model Payout {
  id               Int          @id @default(autoincrement())
  coachId          Int
  coach            CoachProfile @relation(fields: [coachId], references: [id])
  amountCents      Int
  currency         String       @default("USD")
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?      @unique
  stripePayoutId   String?
  periodStart      DateTime
  periodEnd        DateTime
  sessionCount     Int          @default(0)
  grossAmountCents Int
  feeAmountCents   Int
  processedAt      DateTime?
  failReason       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([coachId, status])
  @@index([periodStart, periodEnd])
}

// ─────────────────────────────────────────────
// Webhook Events (idempotency)
// ─────────────────────────────────────────────

/// Transactional outbox: event ghi CÙNG transaction với dữ liệu nghiệp vụ,
/// relay (exam-service) đẩy lên Kafka rồi đánh dấu publishedAt. Không mất event khi Kafka lỗi.
model OutboxEvent {
  id          Int       @id @default(autoincrement())
  topic       String
  /// Kafka message key (vd userId) — cùng key → cùng partition → giữ thứ tự
  key         String?
  payload     Json
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt, id])
}

/// Consumer idempotent: mỗi (eventId, consumer) chỉ xử lý một lần — outbox/Kafka giao "ít nhất một lần".
model ProcessedEvent {
  eventId     String
  consumer    String
  processedAt DateTime @default(now())

  @@id([eventId, consumer])
}

/// Feature flag: bật/tắt tính năng không cần deploy. roles rỗng = mọi người (kể cả khách); có giá trị = chỉ các vai trò đó.
model FeatureFlag {
  key         String   @id
  description String?
  enabled     Boolean  @default(false)
  roles       Role[]
  updatedAt   DateTime @updatedAt
}

model WebhookEvent {
  id           Int                @id @default(autoincrement())
  provider     String
  eventId      String             @unique
  eventType    String
  payload      Json
  status       WebhookEventStatus @default(RECEIVED)
  processedAt  DateTime?
  errorMessage String?
  retryCount   Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([eventType, status])
  @@index([provider, status, createdAt])
}

// ─────────────────────────────────────────────
// Coach Reviews
// ─────────────────────────────────────────────

model CoachReview {
  id        Int             @id @default(autoincrement())
  sessionId Int             @unique
  session   CoachingSession @relation(fields: [sessionId], references: [id])
  learnerId Int
  learner   User            @relation(fields: [learnerId], references: [id])
  coachId   Int
  coach     CoachProfile    @relation(fields: [coachId], references: [id])
  rating    Int
  comment   String?         @db.Text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([coachId, rating])
}

// ─────────────────────────────────────────────
// Real-time: Chat & Notifications
// ─────────────────────────────────────────────

enum NotificationType {
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  SESSION_CONFIRMED
  SESSION_CANCELED
  SESSION_REMINDER
  COACH_MESSAGE
  SUPPORT_MESSAGE
  GROUP_MESSAGE
  SYSTEM
}

enum LearnerChatRoomType {
  DIRECT
  GROUP
}

enum LearnerChatMemberRole {
  MEMBER
  ADMIN
}

model ChatMessage {
  id        Int             @id @default(autoincrement())
  sessionId Int
  session   CoachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User            @relation("SentMessages", fields: [senderId], references: [id])
  content   String
  fileUrl   String?
  fileType  String?
  readAt    DateTime?
  createdAt DateTime        @default(now())

  @@index([sessionId, createdAt])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model SupportThread {
  id            Int              @id @default(autoincrement())
  userId        Int              @unique
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      SupportMessage[]
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([lastMessageAt])
}

model SupportMessage {
  id        Int           @id @default(autoincrement())
  threadId  Int
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User          @relation("SupportMessages", fields: [senderId], references: [id])
  content   String
  fileUrl   String?
  fileType  String?
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
}

model LearnerChatRoom {
  id            Int                  @id @default(autoincrement())
  name          String?
  type          LearnerChatRoomType  @default(GROUP)
  createdById   Int
  createdBy     User                 @relation("CreatedLearnerChats", fields: [createdById], references: [id])
  members       LearnerChatMember[]
  messages      LearnerChatMessage[]
  lastMessageAt DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([lastMessageAt])
  @@index([type])
}

model LearnerChatMember {
  id       Int                   @id @default(autoincrement())
  roomId   Int
  room     LearnerChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   Int
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     LearnerChatMemberRole @default(MEMBER)
  joinedAt DateTime              @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

model LearnerChatMessage {
  id        Int             @id @default(autoincrement())
  roomId    Int
  room      LearnerChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User            @relation("LearnerChatMessages", fields: [senderId], references: [id])
  content   String
  fileUrl   String?
  fileType  String?
  readAt    DateTime?
  createdAt DateTime        @default(now())

  @@index([roomId, createdAt])
}

// ─────────────────────────────────────────────
// Email broadcast jobs
// ─────────────────────────────────────────────

model EmailBroadcast {
  id           String    @id @default(cuid())
  type         String    @default("template") // "template" | "compose"
  templateName String?
  subject      String
  filter       Json      @default("{}")
  totalCount   Int       @default(0)
  sentCount    Int       @default(0)
  failedCount  Int       @default(0)
  status       String    @default("pending") // pending | running | completed | failed
  startedAt    DateTime?
  completedAt  DateTime?
  createdById  Int
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([createdById])
}

// ─────────────────────────────────────────────
// Email templates (admin-editable)
// ─────────────────────────────────────────────

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @unique // matches MailTemplateId
  description String?
  subject     String
  htmlBody    String   @db.Text
  textBody    String   @db.Text
  variables   String[] // documentation of {{varName}} tokens available
  attachments Json     @default("[]") // [{filename, url}]
  active      Boolean  @default(true)
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Email verification & preferences
// ─────────────────────────────────────────────

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailPrefs {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiveProgress       Boolean  @default(true)
  receiveStreak         Boolean  @default(true)
  lastMilestoneNotified Int      @default(0)
  updatedAt             DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Push Notifications
// ─────────────────────────────────────────────

model PushDeviceToken {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("ios") // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────
// Site appearance
// ─────────────────────────────────────────────

model PageBanner {
  id        Int      @id @default(autoincrement())
  // Normalized route path; "__global__" áp dụng cho toàn site
  path      String   @unique
  imageData String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// JLPT mind maps (grammar / vocab / kanji)
// ─────────────────────────────────────────────

enum MindMapKind {
  GRAMMAR
  VOCAB
  KANJI
}

model MindMapLevel {
  id        Int         @id @default(autoincrement())
  kind      MindMapKind
  level     JlptLevel
  title     String
  summary   String      @db.Text
  accent    String      @default("#3b82f6")
  /// [{ id, label, labelJa?, hint?, posX?, posY?, patterns: [{ pattern, meaning, href?, lessonNumber?, linkLabel? }] }]
  branches  Json
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([kind, level])
  @@index([kind, sortOrder])
}
