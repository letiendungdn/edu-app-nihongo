  // Mức moderate chỉ theo dõi, không chặn.
  // Cần ngoại lệ thì thêm GHSA id vào allowlist KÈM lý do và điều kiện gỡ.
  "$schema": "./audit-ci.schema.json",
  "high": true,
  "skip-dev": true,
  "report-type": "summary",
  "allowlist": [
    // node-forge ≤1.4.0 — chưa có bản vá (GHSA-86w9-cpqp-85rv / CVE-2026-85393).
