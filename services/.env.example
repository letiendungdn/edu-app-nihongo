# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# MongoDB
MONGODB_URL=mongodb://localhost:27017/nihongo_audit

# Kafka
KAFKA_BROKERS=localhost:9092

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=edu-app-dev
# Không có key → SDK tự dùng IAM role (ECS/EC2). LocalStack: http://localhost.localstack.cloud:4566
AWS_ENDPOINT_URL=
# URL công khai của file upload (vd CloudFront); trống → theo endpoint / S3 mặc định
ASSET_BASE_URL=

# Timeout mọi lời gọi gateway → microservice (ms); quá hạn trả 504
MICROSERVICE_TIMEOUT_MS=10000
# exam-service: tắt relay outbox (chỉ khi debug) — event vẫn được ghi vào bảng OutboxEvent
OUTBOX_RELAY_DISABLED=false
# exam-service: tắt consumer "progress-updater" (streak, hoạt động exam) — chỉ khi debug
EXAM_CONSUMER_DISABLED=false
# Tắt circuit breaker gateway → microservice (mặc định bật: lỗi ≥ 50%/20 lần gọi → trả 503 trong 30s)
CIRCUIT_BREAKER_DISABLED=false

# Redis
REDIS_URL=redis://localhost:6379

# MQTT (Mosquitto trong docker-compose). Trống → chat SSE chỉ trong một process.
# Broker tắt anonymous: dùng tài khoản gateway, mật khẩu = MQTT_GATEWAY_PASSWORD của compose.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=gateway
MQTT_PASSWORD=gateway-dev

# Database (Nihongo)
DATABASE_URL=postgresql://nihongo:nihongo@localhost:5433/nihongo

# JWT
# Production (NODE_ENV=production) KHÔNG khởi động với giá trị mặc định này — đặt chuỗi ngẫu nhiên ≥ 32 ký tự
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

# Keycloak (OIDC → local JWT exchange)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://auth.localhost:8080/realms/edu-app
KEYCLOAK_REALM=edu-app

# Google OAuth (cùng Client ID cho frontend + backend; secret chỉ để trong .env local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Brevo transactional email (empty BREVO_API_KEY → noop)
BREVO_API_KEY=
MAIL_FROM_EMAIL=noreply@nihongo.local
MAIL_FROM_NAME=Nihongo EDU
APP_PUBLIC_URL=http://nihongo.localhost:8080
MAIL_RESET_EXPIRES_MINUTES=30
