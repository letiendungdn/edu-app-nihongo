# Dependencies
node_modules/

# Local env (secrets). Mẫu biến nằm ở *.env.example và .env.docker.example
.env
services/.env
apps/nihongo-web/.env

# Client secrets JSON
**/client_secret*.json
!**/client_secret.example.json

# SMTP key cho Alertmanager gửi mail thật (infra/alertmanager/README.md)
infra/alertmanager/secrets/*
!infra/alertmanager/secrets/.gitkeep

# Test coverage
coverage/

# Agent / IDE local
.agents/
.claude/
.continue/
.playwright-mcp/

# Screenshot junk at repo root (Playwright / manual captures)
/*.png

# Build output
dist/
*.tsbuildinfo

# Next.js
.next/
out/

# Stripe CLI binary (~27MB, không phải config)
infra/stripe-cli/stripe.exe
infra/stripe-cli/stripe.zip

# Media tải về (Drive — không commit)
apps/nihongo-web/public/media/book-audio/
apps/nihongo-web/public/media/mori-course/
tmp-drive-test/
tmp-mailee.csv
Thumbs.db

# Python (Airflow DAGs)
__pycache__/
.pytest_cache/

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# macOS Finder và trạng thái cửa sổ Xcode (máy local)
.DS_Store
xcuserdata/
*.xcuserstate

# iOS: project.ci.yml sinh từ CI (bỏ LiveKit); SourcePackages khi resolve local
apps/nihongo-ios/project.ci.yml
apps/nihongo-ios/SourcePackages/

# Package dùng chung chạy thẳng từ .ts (main: ./src/index.ts). File biên dịch nằm cạnh .ts bị Node
# load TRƯỚC .ts khi chạy dev (ts-node + tsconfig-paths) → chạy code cũ.
packages/nest-*/src/**/*.js
packages/nest-*/src/**/*.js.map
packages/nest-*/src/**/*.d.ts

# Backup DB đầy đủ chứa dữ liệu cá nhân: chỉ giữ trên máy, không commit (docs/adr/0009-db-backups-out-of-git.md)
infra/backups/*.sql
