# TEMPLATE — KHÔNG commit giá trị thật. Copy thành secret.yaml hoặc dùng GitHub Secrets.
# Deploy workflow (.github/workflows/deploy.yml) ghi đè Secret này từ GitHub Secrets:
#   DATABASE_URL_NIHONGO, JWT_SECRET, POSTGRES_PASSWORD, ADMIN_PASSWORD, MQTT_PASSWORD
apiVersion: v1
kind: Secret
metadata:
  name: edu-app-secrets
  namespace: edu-app
  labels:
    app.kubernetes.io/part-of: edu-platform
type: Opaque
stringData:
  POSTGRES_PASSWORD: change-me-in-production
  DATABASE_URL_NIHONGO: postgresql://nihongo:change-me-in-production@postgres:5432/nihongo
  JWT_SECRET: change-me-in-production
  ADMIN_PASSWORD: change-me-in-production
  MQTT_PASSWORD: change-me-in-production
